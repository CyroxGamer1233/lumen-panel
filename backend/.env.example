PORT=3000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
ALLOW_REGISTRATION=true

# PufferPanel integration (server-side only; never expose these values to the browser)
# Use an HTTPS origin in production. HTTP is accepted only for localhost development.
PUFFERPANEL_URL=
PUFFERPANEL_CLIENT_ID=
PUFFERPANEL_CLIENT_SECRET=
